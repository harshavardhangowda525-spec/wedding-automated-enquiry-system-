# ---- Core -------------------------------------------------------------------
# demo: sample data, simulated messaging, local demo login allowed when Supabase is not configured.
# production: requires Supabase Auth, ENCRYPTION_KEY and CRON_SECRET; never simulates sends.
APP_MODE=demo
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weddingflow
# 32+ random characters. Signs local demo sessions and hashes IPs for consent/audit records.
APP_SECRET=change-me-to-a-long-random-string-of-32-chars
# base64-encoded 32 bytes; encrypts per-studio integration secrets (openssl rand -base64 32)
ENCRYPTION_KEY=

# ---- Supabase Auth ----------------------------------------------------------
# Project URL (https://<ref>.supabase.co) and the anon / publishable key. Used on the server only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Comma-separated emails that are granted platform administration on sign-in.
PLATFORM_ADMIN_EMAILS=

# ---- AI (optional, xAI Grok) -------------------------------------------------
AI_PROVIDER=xai
XAI_API_KEY=
# Required with XAI_API_KEY: a Grok model id enabled for your key (see the model list in the xAI console).
AI_MODEL=
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_HOUR=120
# Optional: only set when you have confirmed current pricing; enables cost estimates.
AI_PRICE_INPUT_PER_MTOK_USD=
AI_PRICE_OUTPUT_PER_MTOK_USD=

# ---- WhatsApp Business Platform (Cloud API) --------------------------------
# Per-studio phone number id + access token are configured in Settings → Integrations.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v23.0

# ---- Email (SMTP) -----------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# ---- Scheduler ----------------------------------------------------------------
# Protects /api/cron/tick when you trigger the job runner from a hosted cron.
CRON_SECRET=
